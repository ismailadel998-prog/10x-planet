{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        "meta": { ".write": true },
        "state": { ".write": true },
        "players": { ".write": true },
        "answers": {
          "$round": {
            "$q": {
              "$pid": { ".write": "!data.exists() && newData.exists()" }
            }
          }
        }
      }
    }
  }
}
